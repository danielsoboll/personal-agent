# Behördenpost — Umgebungsvariablen (Beispiel)

# Supabase (Frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — nur serverseitig (API-Routen, Admin-Tasks)
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Production-Domain-Redirect (wie LifeXP)
# CANONICAL_HOST=post.life-xp.de

# OpenAI — Dokumenten-Analyse (nur serverseitig, Vercel + .env.local)
OPENAI_API_KEY=
# Optional — Standard ohne Override: gpt-5.6 (Flagship, Vision)
# OPENAI_MODEL=gpt-5.6

# Stripe PLUS — Price-ID öffentlich; Secrets in Supabase Edge Functions:
# npx supabase secrets set STRIPE_SECRET_KEY=sk_live_... STRIPE_PRICE_ID=price_... STRIPE_WEBHOOK_SECRET=whsec_... SITE_URL=https://post.life-xp.de
NEXT_PUBLIC_STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_BILLING_ENABLED=true
# NEXT_PUBLIC_SITE_URL=https://post.life-xp.de
